# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
TRADEWINDS_MODEL=claude-sonnet-5-5

# Spend and abuse protection (live runs only)
TRADEWINDS_RUN_BUDGET_USD=1.00
TRADEWINDS_DAILY_BUDGET_USD=20
TRADEWINDS_OPTIONS_PER_HOUR=20
TRADEWINDS_PLANS_PER_HOUR=10
TRADEWINDS_MAX_CONCURRENT=2
TRADEWINDS_MAX_QUEUE=6
# Set to 1 only behind Fly.io's proxy, so Fly-Client-IP is trusted for rate limits
TRADEWINDS_TRUST_PROXY=0

# Langfuse tracing (optional; off when the keys are empty)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
